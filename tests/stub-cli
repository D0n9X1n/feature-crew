#!/bin/bash
PATH=/usr/bin:/bin
cli=$(basename "$0"); st="$FC_STUB_STATE"; mkdir -p "$st"
printf '%s %s\n' "$cli" "$*" >> "$st/calls"
case " $FC_STUB_FAIL " in *" $cli $1 $2 "*) echo "stub: $cli $1 $2 failed" >&2; exit 1 ;; esac
mp="$st/$cli.marketplace"; pl="$st/$cli.plugin"; off="$st/$cli.disabled"; extra="$st/$cli.extra"
case "$1 $2" in
  "plugin list")
    # Like real Copilot, a registered marketplace lists its plugin disabled
    # until `plugin install` enables it. $extra adds other plugins' entries.
    en=false; if [ -f "$pl" ] && [ ! -f "$off" ]; then en=true; fi
    printf '[\n'
    if [ "$cli" = claude ]; then
      [ -f "$pl" ] && printf '  {\n    "id": "feature-crew@feature-crew",\n    "version": "6.0.0",\n    "scope": "user",\n    "enabled": %s\n  },\n' "$en"
    elif [ -f "$pl" ] || [ -f "$mp" ]; then
      printf '  {\n    "name": "feature-crew",\n    "marketplace": "feature-crew",\n    "version": "6.0.0",\n    "enabled": %s\n  },\n' "$en"
    fi
    [ -f "$extra" ] && cat "$extra"
    printf '  {\n    "name": "builtin"\n  }\n]\n' ;;
  "plugin marketplace")
    case "$3" in
      list)
        printf '[\n'
        if [ -f "$mp" ]; then
          if [ "$cli" = claude ]; then printf '  {\n    "name": "feature-crew",\n    "source": "github",\n    "repo": "%s"\n  },\n' "$(cat "$mp")"
          else printf '  {\n    "name": "feature-crew",\n    "source": "GitHub: %s"\n  },\n' "$(cat "$mp")"; fi
        fi
        printf '  {\n    "name": "builtin-market"\n  }\n]\n' ;;
      add) printf '%s' "$4" > "$mp"; echo "stub: marketplace added" ;;
      update) echo "stub: marketplace updated" ;;
      remove) rm -f "$mp" "$pl" "$off"; echo "stub: marketplace removed" ;;
    esac ;;
  "plugin install")
    # FC_STUB_GHOST names a CLI whose install reports success but enables nothing.
    if [ "${FC_STUB_GHOST:-}" != "$cli" ]; then : > "$pl"; rm -f "$off"; fi
    echo "stub: plugin installed" ;;
  "plugin enable") rm -f "$off"; echo "stub: plugin enabled" ;;
  "plugin update") echo "stub: plugin updated" ;;
  "plugin uninstall") rm -f "$pl" "$off"; echo "stub: plugin uninstalled" ;;
  *) echo "stub: unexpected $*" >&2; exit 9 ;;
esac
