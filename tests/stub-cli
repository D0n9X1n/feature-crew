#!/bin/bash
PATH=/usr/bin:/bin
cli=$(basename "$0"); st="$FC_STUB_STATE"; mkdir -p "$st"
printf '%s %s\n' "$cli" "$*" >> "$st/calls"
case " $FC_STUB_FAIL " in *" $cli $1 $2 "*) echo "stub: $cli $1 $2 failed" >&2; exit 1 ;; esac
mp="$st/$cli.marketplace"; pl="$st/$cli.plugin"
case "$1 $2" in
  "plugin list")
    # Like real Copilot, a registered marketplace lists its plugin disabled
    # until `plugin install` enables it.
    if [ "$cli" = claude ]; then
      if [ -f "$pl" ]; then printf '[\n  {\n    "id": "feature-crew@feature-crew",\n    "version": "6.0.0",\n    "enabled": true\n  }\n]\n'
      else echo '[]'; fi
    elif [ -f "$pl" ] || [ -f "$mp" ]; then
      en=false; [ -f "$pl" ] && en=true
      printf '[\n  {\n    "name": "feature-crew",\n    "marketplace": "feature-crew",\n    "version": "6.0.0",\n    "enabled": %s\n  }\n]\n' "$en"
    else echo '[]'; fi ;;
  "plugin marketplace")
    case "$3" in
      list) if [ -f "$mp" ]; then printf '[\n  {\n    "name": "feature-crew"\n  }\n]\n'; else echo '[]'; fi ;;
      add) : > "$mp"; echo "stub: marketplace added" ;;
      update) echo "stub: marketplace updated" ;;
      remove) rm -f "$mp" "$pl"; echo "stub: marketplace removed" ;;
    esac ;;
  "plugin install") : > "$pl"; echo "stub: plugin installed" ;;
  "plugin update") echo "stub: plugin updated" ;;
  "plugin uninstall") rm -f "$pl"; echo "stub: plugin uninstalled" ;;
  *) echo "stub: unexpected $*" >&2; exit 9 ;;
esac
